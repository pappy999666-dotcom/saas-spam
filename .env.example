# --- Core ---
NODE_ENV=development

# Telegram control plane
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_IDS=

# Required in production (32+ chars); auth state is encrypted at rest
ENCRYPTION_SECRET=

# --- Storage ---
SESSION_ROOT=./storage/sessions
MEDIA_ROOT=./data/media

# --- WhatsApp command surface ---
# Per-session default prefix; sessions may override (required|optional|none modes)
DEFAULT_WA_PREFIX=.

# Custom pairing code: EXACTLY 8 letters/digits (transport-enforced)
PAIRING_CUSTOM_CODE=SAASPROM
